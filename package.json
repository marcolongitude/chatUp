{
  "name": "chatup",
  "version": "1.0.9",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --clear",
    "setup:test-env": "./scripts/setup-test-env.sh",
    "check:test-env": "./scripts/check-test-env.sh",
    "start:test-env": "./scripts/start-test-env.sh",
    "start:rancher-mcp:local": "./scripts/start-rancher-mcp-local.sh",
    "deploy:backend-go:rancher": "./scripts/deploy-backend-go-rancher.sh",
    "setup:railway": "./scripts/setup-railway.sh",
    "fix:namespace": "./scripts/fix-duplicate-namespace.sh",
    "clean:android": "./scripts/clean-android-build.sh",
    "clean:android:full": "./scripts/clean-android-build.sh --full",
    "update:eas-env": "./scripts/update-eas-env.sh",
    "start:emulator": "./scripts/start-emulator.sh",
    "start:emulator:clear": "./scripts/start-emulator.sh --clear",
    "fix:emulator": "./scripts/fix-emulator.sh",
    "fix:downloading": "./scripts/fix-downloading.sh",
    "android": "expo run:android",
    "android:emulator": "ANDROID_SERIAL=emulator-5554 expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "install:fix": "npm install --legacy-peer-deps",
    "check:deps": "npx expo install --check",
    "build:android:apk": "eas build --platform android --profile production --local",
    "build:android:apk:cloud": "eas build --platform android --profile production",
    "build:android:apk:preview": "eas build --platform android --profile preview --local",
    "build:android:preview:cloud": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production-aab --local",
    "build:android:aab:cloud": "eas build --platform android --profile production-aab",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "build:android:local": "eas build --platform android --profile preview --local --non-interactive",
    "build:android:dev": "./scripts/build-android-dev.sh",
    "install:android": "./scripts/install-apk-usb.sh",
    "install:android:device": "./scripts/install-apk-device.sh",
    "install:android:emulator": "./scripts/install-apk-emulator.sh",
    "setup:debug:emulator": "./scripts/setup-debug-emulator.sh",
    "build:install:android": "npm run build:android:local && npm run install:android",
    "build:install:device": "npm run build:android:apk && npm run install:android:device",
    "build:install:emulator": "npm run build:android:apk:preview && npm run install:android:emulator",
    "install:android:usb": "./scripts/install-apk-usb.sh",
    "debug": "npx react-native-debugger-open",
    "debug:metro": "npx react-native start --reset-cache",
    "debug:open": "open http://localhost:8081/debugger-ui/ || xdg-open http://localhost:8081/debugger-ui/",
    "connect:emulator": "./scripts/connect-emulator.sh",
    "pair:usb-emulator": "./scripts/pair-usb-emulator.sh",
    "pair:usb-emulator:full": "./scripts/pair-usb-emulator.sh --start-emu --install --launch",
    "e2e:pair": "./e2e/run.sh -m pair",
    "e2e:pair:smoke": "./e2e/run.sh -m smoke",
    "e2e:pair:notify": "./e2e/run.sh tests/test_pair_notify_delivery.py",
    "e2e:family:security": "./e2e/run-api.sh tests/test_family_security_api.py",
    "e2e:family:ui": "./e2e/run.sh tests/test_family_ui_pair.py",
    "test:notify": "jest --testPathPattern='(delivery-status|notifications|MessageStatus)'",
    "test:family": "cd backend-go && go test ./internal/app/ -count=1 -run 'Family|Nearby'",
    "test:guardrails": "./scripts/test-guardrails.sh --full",
    "test:guardrails:unit": "./scripts/test-guardrails.sh --unit",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push scripts/test-guardrails.sh",
    "eas:setup": "eas build:configure",
    "eas:login": "eas login",
    "eas:logout": "eas logout",
    "eas:whoami": "eas whoami",
    "eas:env:list": "eas env:list",
    "eas:env:help": "echo 'Para adicionar variáveis de ambiente, use: eas env:create production --scope project --name NOME --value VALOR --type string --visibility plaintext --non-interactive'",
    "clean": "rm -rf node_modules && npm cache clean --force",
    "clean:build": "rm -rf android ios .expo",
    "fix:gradle": "./fix-gradle-build.sh",
    "build:android:apk:debug": "./capture-build-errors.sh",
    "build:android:apk:verbose": "EAS_LOCAL_BUILD_SKIP_CLEANUP=1 eas build --platform android --profile production --local --non-interactive",
    "analyze:bundle": "./scripts/analyze-bundle.sh",
    "optimize:images": "./scripts/optimize-images.sh",
    "update:preview": "eas update --branch preview --message \"Atualização automática\" --platform android",
    "update:production": "eas update --branch production --message \"Atualização automática\" --platform android",
    "update:preview:interactive": "eas update --branch preview --platform android",
    "update:production:interactive": "eas update --branch production --platform android",
    "clear:local:messages": "npx ts-node scripts/clear-local-messages.ts",
    "lint:architecture": "steiger ./src",
    "lint:architecture:strict": "steiger ./src --fail-on-warnings"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@stablelib/hkdf": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "@stablelib/x25519": "^2.0.1",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-devtools": "^1.167.0",
    "axios": "^1.19.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-styled-components": "^2.3.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "events": "^3.3.0",
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "^15.0.7",
    "expo-sqlite": "~16.0.9",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.10.10",
    "process": "^0.11.10",
    "protobufjs": "^7.6.5",
    "react": "^19.0.2",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "styled-components": "^6.4.4",
    "text-encoding": "^0.7.0",
    "util": "^0.12.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@feature-sliced/steiger-plugin": "^0.5.8",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/styled-components": "^5.1.34",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-dom": "^19.0.2",
    "react-test-renderer": "^19.0.2",
    "steiger": "^0.5.13",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
